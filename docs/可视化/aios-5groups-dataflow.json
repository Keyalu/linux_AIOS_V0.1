        "id": "intent-to-plan",
        "label": "意图 → 安全 → 规划",
        "focus": [
          "host_agent",
          "intent_json",
          "sandbox",
          "check_json",
          "planner",
          "plan_json"
        ],
        "note": "前三段：一句自然语言变成可执行计划；安全闸门不放行就不会进入规划。"
      },
      {
        "id": "execute-and-ledger",
        "label": "执行与逐笔落账",
        "focus": [
          "plan_json",
          "app_agent",
          "registry",
          "stats_json",
          "session_json"
        ],
        "note": "组3 逐步调用组4；每笔调用落进 stats.json，执行结果汇成 session_log.json。"
      },
      {
        "id": "audit-loop",
        "label": "执行后对账闭环",
        "focus": [
          "session_json",
          "auditor",
          "audit_json",
          "stats_json"
        ],
        "note": "组5 用 session 逐条结果做两向自比对，再叠加计划步数一致性，产出 verdict。"
      },
      {
        "id": "json-artifacts",
        "label": "六份中间产物",
        "focus": [
          "intent_json",
          "check_json",
          "plan_json",
          "session_json",
          "audit_json",
          "stats_json"
        ],
        "note": "控制台「中间产物」六个页签直接读这六份文件。"
      }
    ]
